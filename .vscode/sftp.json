{
  "name": "opnsense-dev",
  "host": "127.0.0.1",
  "port": 2200, 
  "protocol": "sftp",
  "username": "vagrant",
  "privateKeyPath": "vagrant-opnsense/.vagrant/machines/default/virtualbox/private_key", 
  "context": "core",
  "remotePath": "/var/vagrant/core",
  "uploadOnSave": true,
  "downloadOnOpen": false,
  "useTempFile": false,
  "openSsh": false,
  "concurrency": 1,
  "watcher": {
    "files": "**/*",
    "autoUpload": true,
    "autoDelete": false
  },
  "ignore": [
    ".git",
    "work",
    "src/etc/sudoers.d"
  ],
  "filePermRules": [
    {
      "match": [
        "Scripts/**",
        "contrib/**",
        "src/etc/rc*",
        "src/etc/rc.d/**",
        "src/etc/rc.subr.d/**",
        "src/etc/rc.syshook.d/**",
        "src/etc/inc/plugins.inc.d/openvpn/**",
        "src/libexec/**",
        "src/sbin/**",
        "src/opnsense/mvc/script/**",
        "src/opnsense/scripts/**",
        "src/opnsense/service/**"
      ],
      "perm": "755"
    }
  ]
}